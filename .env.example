DATABASE_URL="file:./dev.db"
# Required in production: a random string of 32+ characters. Generate one with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Set to "true" only when running behind a reverse proxy you control (so X-Forwarded-For is trustworthy).
TRUST_PROXY="false"
# Optional: comma-separated origins allowed to open real-time connections, e.g. "https://pulse.example.com".
# Defaults to the same host that served the page.
ALLOWED_ORIGINS=""
